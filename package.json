{
  "name": "orbit-calendar",
  "productName": "Orbit Calendar",
  "private": true,
  "version": "1.0.0",
  "description": "Calendario desktop in stile Notion Calendar",
  "author": "Orbit",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "app": "npm run build && electron .",
    "app:dev": "electron . --dev",
    "icon": "electron scripts/make-icon.cjs",
    "dist": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.orbit.calendar",
    "productName": "Orbit Calendar",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Orbit Calendar",
      "artifactName": "Orbit-Calendar-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Orbit-Calendar-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "zustand": "^5.0.15"
  }
}
